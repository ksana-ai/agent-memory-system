POSTGRES_DB=agent_memory
POSTGRES_USER=agent_memory
POSTGRES_PASSWORD=agent_memory_dev
POSTGRES_PORT=55432
DATABASE_URL=postgres://agent_memory:agent_memory_dev@127.0.0.1:55432/agent_memory?sslmode=disable
TEST_DATABASE_URL=postgres://agent_memory:agent_memory_dev@127.0.0.1:55432/agent_memory?sslmode=disable
LMSTUDIO_EMBEDDINGS_URL=http://127.0.0.1:1234/v1/embeddings
LMSTUDIO_EMBEDDING_MODEL=text-embedding-bge-m3
# The server defaults to fts and does not read or probe the LM Studio settings.
# dense/hybrid are explicit opt-ins and require the exact promoted serving space.
SERVER_RETRIEVAL_MODE=fts
SERVER_EXPECTED_SERVING_SPACE=
# Fill this with the exact space printed by `make projection-worker-probe`.
# Worker startup fails closed if a later live probe does not match it.
PROJECTION_WORKER_EMBEDDING_SPACE=
PROJECTION_WORKER_REQUEST_TIMEOUT=15s
PROJECTION_WORKER_LEASE_DURATION=30s
PROJECTION_WORKER_IDLE_INTERVAL=500ms
PROJECTION_WORKER_MAX_ATTEMPTS=5
# The reconciler never calls the embedding endpoint. Set this to an already
# registered target space; audit does not mutate projection/card state, while
# startup may apply migrations and coverage queries take bounded row locks.
PROJECTION_RECONCILER_EMBEDDING_SPACE=
PROJECTION_RECONCILER_MODE=audit
PROJECTION_RECONCILER_BATCH_SIZE=100
# Promotion performs a fresh public-probe request and fails unless the derived
# immutable space equals this already registered, fully covered shadow target.
PROJECTION_PROMOTER_EMBEDDING_SPACE=
# Use a new canonical lowercase UUID for each intended transition. Retrying the
# exact same ID and command returns the original durable receipt before probing.
# Example generation: `uuidgen | tr '[:upper:]' '[:lower:]'`.
PROJECTION_PROMOTER_OPERATION_ID=
# Set the current serving space exactly, or the literal `none` when no serving
# space is expected. This is a compare-and-swap precondition, not discovery.
PROJECTION_PROMOTER_EXPECTED_FROM=none
# Empty deployments fail closed by default. Override only for a deliberate
# bootstrap/empty-database transition whose durable receipt should say so.
PROJECTION_PROMOTER_ALLOW_EMPTY=false
